rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && request.auth.token.get('email', '') == 'any0cook@gmail.com';
    }

    // スタッフ名簿：ログイン確認のため読み取りは可、変更は管理者のみ
    match /staff/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // 時給履歴：管理者のみ
    match /wages/{id} {
      allow read, write: if isAdmin();
    }

    // 勤怠記録
    match /records/{id} {
      allow read: if signedIn();
      allow create: if isAdmin() || (
        signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.staffId is string
        && exists(/databases/$(database)/documents/staff/$(request.resource.data.staffId))
        && request.resource.data.date is string
        && request.resource.data.work is number
        && request.resource.data.work >= 0
        && request.resource.data.work <= 1440
      );
      allow update: if isAdmin();
      // スタッフは自分の端末で入力した記録だけ削除できる
      allow delete: if isAdmin() || (signedIn() && resource.data.get('uid', '') == request.auth.uid);
    }
  }
}
